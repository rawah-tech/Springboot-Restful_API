# Safe template only: replace every placeholder in your local process environment.
SPRING_DATASOURCE_URL=jdbc:mysql://localhost:3306/process_governance?useSSL=false&serverTimezone=UTC&allowPublicKeyRetrieval=true
SPRING_DATASOURCE_USERNAME=replace_with_local_mysql_username
SPRING_DATASOURCE_PASSWORD=replace_with_local_mysql_password

# Generate a new secret of at least 64 characters locally. Never reuse a historical value.
JWT_SECRET=replace_with_a_new_long_random_secret_of_at_least_64_characters
JWT_EXPIRATION_MS=86400000

UPLOAD_DIR=./uploads
