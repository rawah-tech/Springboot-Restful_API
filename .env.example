# Copy these names into your deployment environment and replace every placeholder.
SPRING_DATASOURCE_URL=jdbc:mysql://localhost:3306/replace_with_database_name
SPRING_DATASOURCE_USERNAME=replace_with_database_username
SPRING_DATASOURCE_PASSWORD=replace_with_database_password

# Replace this with a newly generated, long random value. Never reuse an exposed key.
JWT_SECRET=replace_with_a_newly_generated_long_random_value
JWT_EXPIRATION_MS=86400000

UPLOAD_DIR=./uploads
