    {
      "name": "04 - Process Status Filters",
      "description": "The path capitalization follows ProcessController exactly.",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "const expectedStatuses = {",
              "  '16.1 - Filter For Review': 'For Review',",
