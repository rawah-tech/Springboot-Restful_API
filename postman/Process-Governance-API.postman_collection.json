{
  "info": {
    "name": "Process Governance API",
    "description": "Portable local portfolio run for the Process Governance API. Run database/schema.sql and database/sample-data.sql first, start the application, select the supplied Local environment, and run this collection in order. The run creates a temporary ROLE_USER account and disposable department/process/task records, then removes the business records during cleanup. The generated account remains because the current API has no user-deletion endpoint.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{accessToken}}",
        "type": "string"
      }
    ]
  },
  "item": [
    {
      "name": "01 - Readiness and Authentication",
      "item": [
        {
          "name": "01 - Public readiness check",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const suffix = `${Date.now().toString(36)}${Math.random().toString(36).slice(2, 6)}`;",
                  "const username = `reviewer${suffix}`.slice(0, 20);",
                  "const email = `${username}@example.test`;",
                  "const password = `Demo-${suffix}!`.slice(0, 40);",
                  "",
                  "pm.environment.set('generatedUsername', username);",
                  "pm.environment.set('generatedEmail', email);",
                  "pm.environment.set('generatedPassword', password);",
                  "['accessToken', 'departmentId', 'processId', 'taskId'].forEach((key) => {",
                  "  pm.environment.set(key, '');",
                  "});"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 200', () => pm.response.to.have.status(200));",
                  "pm.test('Public readiness response is present', () => {",
                  "  pm.expect(pm.response.text()).to.eql('Public Content.');",
                  "});",
                  "pm.test('Generated credentials satisfy API validation limits', () => {",
                  "  const username = pm.environment.get('generatedUsername');",
                  "  const password = pm.environment.get('generatedPassword');",
                  "  pm.expect(username.length).to.be.within(3, 20);",
                  "  pm.expect(password.length).to.be.within(6, 40);",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "auth": {
              "type": "noauth"
            },
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/test/all",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "test",
                "all"
              ]
            },
            "description": "Public readiness endpoint. Its pre-request script initializes unique run credentials and clears any token or resource IDs left by a prior run."
          },
          "response": []
        },
        {
          "name": "02 - Sign up generated user",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 200', () => pm.response.to.have.status(200));",
                  "pm.test('Signup confirms registration', () => {",
                  "  const body = pm.response.json();",
                  "  pm.expect(body.message).to.eql('User registered successfully!');",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "auth": {
              "type": "noauth"
            },
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json",
                "type": "text"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"{{generatedUsername}}\",\n  \"email\": \"{{generatedEmail}}\",\n  \"password\": \"{{generatedPassword}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/api/auth/signup",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "auth",
                "signup"
              ]
            },
            "description": "Creates a synthetic local user. No role is requested; public signup assigns ROLE_USER in the current implementation."
          },
          "response": []
        },
        {
          "name": "03 - Sign in generated user",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 200', () => pm.response.to.have.status(200));",
                  "const body = pm.response.json();",
                  "pm.test('Signin returns an access token', () => {",
                  "  pm.expect(body.accessToken).to.be.a('string').and.not.empty;",
                  "});",
                  "pm.test('Signin returns ROLE_USER', () => {",
                  "  pm.expect(body.roles).to.be.an('array').that.includes('ROLE_USER');",
                  "});",
                  "if (body.accessToken) {",
                  "  pm.environment.set('accessToken', body.accessToken);",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "auth": {
              "type": "noauth"
            },
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json",
                "type": "text"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"{{generatedUsername}}\",\n  \"password\": \"{{generatedPassword}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/api/auth/signin",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "auth",
                "signin"
              ]
            },
            "description": "Authenticates the generated user and saves accessToken for collection-level Bearer authentication."
          },
          "response": []
        },
        {
          "name": "04 - Authenticated user check",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 200', () => pm.response.to.have.status(200));",
                  "pm.test('ROLE_USER endpoint is accessible', () => {",
                  "  pm.expect(pm.response.text()).to.eql('User Content.');",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/test/user",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "test",
                "user"
              ]
            },
            "description": "Checks the method-level ROLE_USER authorization using the saved JWT."
          },
          "response": []
        }
      ]
    },
